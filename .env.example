# ZeptoMail (server-only — never prefix with VITE_)
ZEPTOMAIL_URL=https://api.zeptomail.com.au/v1.1/email

# Send Mail Token from ZeptoMail Agent → SMTP/API
# Can be raw token or already prefixed with "Zoho-enczapikey "
ZEPTOMAIL_TOKEN=

ZEPTOMAIL_FROM_ADDRESS=info@bmspros.com.au
ZEPTOMAIL_FROM_NAME=BMS Pro

# Where contact / demo requests are delivered
CONTACT_TO_EMAIL=info@bmspros.com.au

# Local API server port (Vite proxies /api here)
API_PORT=3001
